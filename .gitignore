# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Runtime artifacts
.runs/
# Deployment engine state: tenant execution secrets, generated nginx config and
# per-deploy work directories. Never commit these -- the tenant files contain the
# secret the audit sidecar authenticates to core with.
.helios-run/
engine.log
data/core/
.helios-data/

# Local environment
.env

dev-resources

# Agent worktrees: one per session, never tracked
.qwen/worktrees/

# Teammates' raw untracked work. Read-only reference material; lives only in
# the main checkout, and importing from it means copying files out, never
# committing the folder.
OTHER-TEAMMATE-STUFF/

# OS noise
.DS_Store