# Helios agent integration — environment template
#
# Copy to .env, fill in, then load it:
#     cp .env.example .env
#     set -a; source .env; set +a          # bash / zsh
# Then check the connection before running an agent:
#     agent-integration doctor
#
# .env is gitignored; .env.example is not. Nothing here is required: with no
# token at all, `demo`, `selfcheck`, `inspect` and `run --offline` all work,
# and grants are signed with an ephemeral process key.

# --- Model (the action agent) ---------------------------------------------
#
# Qwen via Alibaba Cloud Model Studio (DashScope) in OpenAI-compatible mode.
# Qwen is the only generative model the competition permits. The key is sent as
# `Authorization: Bearer <token>` — a plain DashScope API key, not a JWT.
#
# Accepted variable names, in priority order:
#   HELIOS_LLM_API_KEY, LLM_API_TOKEN, DASHSCOPE_API_KEY
HELIOS_LLM_API_KEY=

# Model id. qwen3.8-max is the flagship; qwen3.8-flash is cheaper and faster.
HELIOS_LLM_MODEL=qwen3.8-max

# Endpoint. Leave this at the public URL UNLESS your key is scoped to a
# specific workspace or region, in which case Model Studio issues a base URL of
# the form https://{WorkspaceId}.<region>.maas.aliyuncs.com/compatible-mode/v1.
# The OpenAI-compatible base URL ends in /compatible-mode/v1 and excludes
# /chat/completions, which the driver appends.
#
# Public DashScope OpenAI-compatible endpoints:
#   https://dashscope.aliyuncs.com/compatible-mode/v1                    (mainland / Beijing)
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1               (Singapore)
#
# Override with `--base-url` on the command line if you prefer.
HELIOS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Thinking mode. qwen3.8-max is a hybrid-thinking model: true reasons before
# answering (better for multi-step tool use, more output tokens), false replies
# directly. `doctor` forces false for its cheap connectivity ping.
HELIOS_LLM_ENABLE_THINKING=true

# Cap on reasoning tokens when thinking is on. Valid range 1-32768. Leave at 0
# to omit the parameter and let the model use its own maximum.
HELIOS_LLM_THINKING_BUDGET=0

# Output cap per turn. An agent turn is a tool call or a short sentence, so
# 4096 is plenty and much cheaper than the model's ceiling.
HELIOS_LLM_MAX_TOKENS=4096

# --- Audit signing ---------------------------------------------------------
# The audit agent signs every grant with HMAC-SHA256. Without this key it
# falls back to an ephemeral process key: the replay and tamper checks still
# run, but grants do not survive a restart and two processes cannot verify
# each other. Generate one with:  openssl rand -hex 32
HELIOS_AUDIT_SIGNING_KEY=

# A label recorded on grants so you can tell which key signed what. This is
# never the key itself.
HELIOS_AUDIT_SIGNING_KEY_ID=helios-audit-local

# --- Runtime shape ---------------------------------------------------------
# How the action agent reaches the auditor: inprocess | file | http
# `http` is the deployment shape — the auditor as its own service, reachable
# only through the contract, never by import.
HELIOS_AUDIT_TRANSPORT=inprocess

# Where run state and audit evidence are written.
HELIOS_RUNS_DIR=.runs
HELIOS_DATA_DIR=.helios-data
