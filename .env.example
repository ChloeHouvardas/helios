# Local environment template — copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   $EDITOR .env
#   source .env
#
# .env is gitignored. This file (.env.example) is tracked and holds placeholders only.
# Nothing in the repo auto-loads .env — `source .env` is required in every session.

# --- Tushare Pro market data -------------------------------------------------
# Competition-issued token, one per team. Read by the market-data adapter.
# Keep it quoted and free of stray whitespace; an invalid or expired token
# surfaces as an API error, not a crash.
export TUSHARE_TOKEN=""

# --- Intent verification signing secret --------------------------------------
# Optional. fin_tools/service.py reads this for HMAC intent binding; it already
# falls back to a dev-only default, so local tests run without it. Set a real
# value only when running the tool server across a process boundary.
# export HELIOS_INTENT_SECRET=""